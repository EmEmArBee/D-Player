<resources>
    <style name="Theme.DPlayer" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:statusBarColor">@android:color/black</item>
        <item name="android:navigationBarColor">@android:color/black</item>
    </style>

    <!-- FULL GLASS skin: real window translucency so the head unit's own
         background shows through behind the app, instead of just painting
         black in Compose. Selected at runtime in MainActivity before
         super.onCreate(), based on the saved SkinConfig. -->
    <style name="Theme.DPlayer.Glass" parent="android:Theme.Translucent.NoTitleBar">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowNoTitle">true</item>
        <!-- Without this a translucent window just shows black: there's
             nothing else in the task stack behind a freshly-launched
             Activity. This tells the system to composite the device's own
             wallpaper underneath. -->
        <item name="android:windowShowWallpaper">true</item>
    </style>
</resources>
